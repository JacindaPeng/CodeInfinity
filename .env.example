# Docker Compose / 根目录环境变量（复制为 .env 后填写）
# cp .env.example .env

LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
JWT_SECRET=please-replace-with-a-long-random-string

# 容器内默认开发短信模式（固定码 123456，不调用阿里云）
SMS_DEV_MODE=1
SMS_DEV_CODE=123456

# 真发短信时改为 0，并填写下方（与 backend/.env 相同；勿提交仓库）
# SMS_DEV_MODE=0
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_PNVS_SIGN_NAME=
# ALIYUN_PNVS_TEMPLATE_CODE=

# 可选其它 LLM
# OPENAI_API_KEY=
# QWEN_API_KEY=
