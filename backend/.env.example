# DeepSeek (默认)
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI（OpenAI 兼容中转时填写）
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini（OpenAI 兼容中转时填写）
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.0-flash

# Claude（OpenAI 兼容中转时填写）
# CLAUDE_API_KEY=your-claude-api-key
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# CLAUDE_MODEL=claude-sonnet-4

# Qwen (可选)
# QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 月之暗面 Kimi (可选)
# MOONSHOT_API_KEY=your-moonshot-api-key
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k

# 智谱 GLM (可选)
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# 应用配置
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 短信验证码（开发默认 SMS_DEV_MODE=1，固定码 123456，不真正发短信）
SMS_DEV_MODE=1
SMS_DEV_CODE=123456
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_MAX_VERIFY_ATTEMPTS=5
# 真发短信：个人实名可用 PNVS（无需企业资质）
# 控制台开启：https://dypns.console.aliyun.com/functions → 短信认证
# 在「赠送签名/模板」页复制 SignName、TemplateCode 到下方
# SMS_DEV_MODE=0
# ALIYUN_SMS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_SMS_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_PNVS_SIGN_NAME=控制台赠送签名名称
# ALIYUN_PNVS_TEMPLATE_CODE=控制台赠送模板编号

SQLITE_PATH=../data/course.db
CHROMA_PATH=../data/chroma
UPLOAD_DIR=../data/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:80
# 语音识别（可选）：ffmpeg 可执行文件完整路径；留空则自动从 PATH / WinGet 定位
# FFMPEG_PATH=C:\Users\ohmyc\AppData\Local\Microsoft\WinGet\Links\ffmpeg.exe

# 本地视频 ASR（自研主路径）。改模型后请对已有视频重新索引：
#   cd backend && python -m scripts.reindex_videos
# tiny 最快；base 课设推荐；small 更准更慢
WHISPER_MODEL=base
WHISPER_LANGUAGE=zh
# WHISPER_INITIAL_PROMPT=这是一段大学计算机编程课程讲解。内容涉及 C 语言、指针、数组、函数、循环、结构体、字符串、Dennis Ritchie、Unix、编译、调试。
VIDEO_CHUNK_SECONDS=30
VIDEO_CHUNK_GAP_SEC=1.8
VIDEO_CHUNK_OVERLAP_SEC=4

# 知识推送（站内每日推荐；不做站点重爬）
KNOWLEDGE_PUSH_HOUR=8
KNOWLEDGE_PUSH_MINUTE=0
KNOWLEDGE_PUSH_LIMIT=3
# 可选 Bing Web Search；留空则仅从白名单 RSS 拉取
# SEARCH_API_KEY=
