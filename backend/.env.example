# DeepSeek (默认)
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI（Jeniya 中转，OpenAI 兼容）
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://jeniya.top/v1
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini（Jeniya 中转，OpenAI 兼容）
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_BASE_URL=https://jeniya.top/v1
# GEMINI_MODEL=gemini-3.5-flash

# Claude（Jeniya 中转，OpenAI 兼容）
# CLAUDE_API_KEY=your-claude-api-key
# CLAUDE_BASE_URL=https://jeniya.top/v1
# CLAUDE_MODEL=claude-sonnet-5

# Qwen (可选)
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 月之暗面 Kimi (可选)
# MOONSHOT_API_KEY=your-moonshot-api-key
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k

# 智谱 GLM (可选)
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# 应用配置
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SQLITE_PATH=../data/course.db
CHROMA_PATH=../data/chroma
UPLOAD_DIR=../data/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:80
# 语音识别（可选）：ffmpeg 可执行文件完整路径；留空则自动从 PATH / WinGet 定位
# FFMPEG_PATH=C:\Users\ohmyc\AppData\Local\Microsoft\WinGet\Links\ffmpeg.exe
